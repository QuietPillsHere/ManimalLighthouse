<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <Nullable>enable</Nullable>
    <AssemblyName>ManimalLighthouse.Shared</AssemblyName>
    <Version>$(ModVersion)</Version>
    <ModClientPath Condition="'$(ModClientPath)' == ''">$(SPTPath)/BepInEx/plugins/$(ModClientName)</ModClientPath>
    <ModServerPath Condition="'$(ModServerPath)' == ''">$(ServerPath)/user/mods/$(ModServerName)</ModServerPath>
  </PropertyGroup>
  <Target Name="GenerateModIdentity" BeforeTargets="CoreCompile">
    <ItemGroup>
      <_ModIdentityLine Include="// Generated from Directory.Build.props. Do not edit." />
      <_ModIdentityLine Include="namespace Manimal.Lighthouse.Shared { public static class ModIdentity {" />
      <_ModIdentityLine Include="public const string Version = &quot;$(ModVersion)&quot;%3B" />
      <_ModIdentityLine Include="public const string Guid = &quot;$(ModGuid)&quot;%3B" />
      <_ModIdentityLine Include="public const string Author = &quot;$(ModUsername)&quot;%3B" />
      <_ModIdentityLine Include="public const string ClientName = &quot;$(ModClientName)&quot;%3B" />
      <_ModIdentityLine Include="public const string ServerName = &quot;$(ModServerName)&quot;%3B" />
      <_ModIdentityLine Include="public const string SourceUrl = &quot;$(ModSourceUrl)&quot;%3B" />
      <_ModIdentityLine Include="} }" />
    </ItemGroup>
    <WriteLinesToFile File="$(IntermediateOutputPath)ModIdentity.g.cs" Lines="@(_ModIdentityLine)" Overwrite="true" WriteOnlyWhenDifferent="true" />
    <ItemGroup>
      <Compile Include="$(IntermediateOutputPath)ModIdentity.g.cs" />
    </ItemGroup>
  </Target>
  <Target Name="InstallSharedLibrary" AfterTargets="Build" Condition="'$(DesignTimeBuild)' != 'true'">
    <MakeDir Directories="$(ModClientPath);$(ModServerPath)" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(ModClientPath)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(ModServerPath)" SkipUnchangedFiles="true" />
  </Target>
</Project>
